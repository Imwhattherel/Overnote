{
  "name": "overnote",
  "version": "2.1.0",
  "description": "Overnote: colorful desktop notes, folders, pop-outs and reminders",
  "author": "whattherel",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "test": "node tests/smoke.js && node tests/features.js && node tests/new_features.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.whattherel.overnote",
    "productName": "Overnote",
    "files": [
      "main.js",
      "backup-tools.js",
      "preload.js",
      "index.html",
      "alarm.html",
      "alarm-preload.js",
      "assets/**/*",
      "note-formats.js",
      "note-security.js",
      "storage-tools.js",
      "LICENSE",
      "sticky-import.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "legalTrademarks": "Overnote \u00b7 whattherel"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "Overnote-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Overnote-Portable.${ext}"
    },
    "asarUnpack": [
      "assets/**/*"
    ]
  },
  "homepage": "https://github.com/Imwhattherel/Overnote",
  "repository": {
    "type": "git",
    "url": "https://github.com/Imwhattherel/Overnote.git"
  },
  "license": "MIT"
}